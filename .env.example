JARVIS_ENVIRONMENT=development
JARVIS_DATABASE_URL=postgresql+psycopg://jarvis_runtime:jarvis_runtime_dev_only@localhost:5432/jarvis
JARVIS_MIGRATION_DATABASE_URL=postgresql+psycopg://jarvis_owner:jarvis_dev_only@localhost:5432/jarvis
JARVIS_SESSION_HMAC_KEY=replace-with-at-least-32-random-characters
JARVIS_SESSION_HMAC_KEY_VERSION=v1
# Leave blank in local development to derive a test-only key from the HMAC key.
JARVIS_TOKEN_ENCRYPTION_KEY=
JARVIS_WEB_ORIGIN=http://localhost:5173

# Generic OIDC configuration. Leave unset to disable interactive OIDC login.
JARVIS_OIDC_ISSUER=
JARVIS_OIDC_CLIENT_ID=
JARVIS_OIDC_CLIENT_SECRET=
JARVIS_OIDC_AUTHORIZATION_ENDPOINT=
JARVIS_OIDC_TOKEN_ENDPOINT=
JARVIS_OIDC_JWKS_URI=
JARVIS_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
JARVIS_OIDC_OWNER_SUBJECT=
JARVIS_OIDC_REQUIRED_AMR=["mfa"]

VITE_API_ORIGIN=

